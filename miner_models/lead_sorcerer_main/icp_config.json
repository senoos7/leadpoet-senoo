{
  "name": "B2B Cybersecurity and AI Startups",
  "icp_text": "B2B cybersecurity, AI/ML, and SaaS technology startups with 10-500 employees, founded after 2015, based in the United States. Target companies with publicly listed founders or CEOs who have contact information on the company website. Ideal contacts are CEO, Co-Founder, CTO, or VP-level decision makers at venture-backed or bootstrapped startups.",
  "queries": [
    "seed stage cybersecurity startup founder CEO email \"contact\" site:*.io -site:linkedin.com -site:github.com -site:crunchbase.com -site:medium.com -site:youtube.com",
    "\"series A\" OR \"series B\" AI security startup co-founder email \"team\" OR \"about\" site:*.ai -site:linkedin.com -site:github.com -site:reddit.com -site:crunchbase.com",
    "B2B cybersecurity startup founded 2020 OR 2021 OR 2022 CEO founder \"contact us\" email -site:linkedin.com -site:github.com -site:medium.com -site:youtube.com -site:techcrunch.com",
    "cybersecurity SaaS startup \"meet the team\" OR \"our founders\" CEO email site:*.com -site:linkedin.com -site:github.com -site:reddit.com -site:medium.com -site:crunchbase.com -site:crowdstrike.com -site:darktrace.com",
    "AI startup \"co-founder\" email \"Seattle\" OR \"Boston\" OR \"Denver\" OR \"Chicago\" \"contact\" -site:linkedin.com -site:github.com -site:medium.com -site:crunchbase.com"
  ],
  "specific_urls": [],
  "default_contact_linkedin": "",
  "required_fields": {
    "company": ["name", "industry", "sub_industry"],
    "contact": ["email", "job_title", "full_name"]
  },
  "optional_fields": {
    "company": ["hq_location", "revenue_range", "employee_count", "specialties", "founded_year", "company_type", "number_of_locations", "ownership_type"],
    "contact": ["phone", "linkedin_url", "decision_maker", "department", "seniority"]
  },
  "threshold": 0.3,
  "filtering_strict": false,
  "mode": "fast",
  "refresh_policy": {
    "revisit_after_days": 90,
    "failure_revisit_days": 7,
    "domain_serp_ttl_hours": 6,
    "crawl_ttl_days": 14,
    "enrich_ttl_days": 30
  },
  "concurrency": {
    "max_concurrent_requests": 3
  },
  "search": {
    "max_pages": 1,
    "max_results_per_query": 10
  },
  "testing": {
    "process_rejected": true,
    "process_low_crawl": true,
    "force_contact_discovery": true
  },
  "caps": {
    "company_usd": 0.02,
    "contact_usd": 0.03,
    "run_usd_max": 10.0,
    "max_domains_per_run": 20,
    "max_crawl_per_run": 20,
    "max_enrich_per_run": 20
  },
  "role_priority": {
    "founder": 1,
    "owner": 1,
    "ceo": 1,
    "president": 1,
    "advisor": 2,
    "partner": 2,
    "director": 3,
    "consultant": 4,
    "default": 99
  },
  "exports": {
    "enabled": true
  },
  "default_country": "United States",
  "exclusion_criteria": {
    "ownership_types": [],
    "max_locations": 10000,
    "excluded_keywords": [],
    "excluded_domains": [
      "linkedin.com", "github.com", "reddit.com", "twitter.com", "x.com",
      "youtube.com", "facebook.com", "instagram.com", "tiktok.com",
      "medium.com", "substack.com", "dev.to",
      "techcrunch.com", "venturebeat.com", "wired.com", "forbes.com",
      "bloomberg.com", "businessinsider.com", "inc.com",
      "zoominfo.com", "apollo.io", "hunter.io", "clearbit.com",
      "rocketreach.co", "snov.io", "seamless.ai", "contactout.com",
      "crunchbase.com", "pitchbook.com", "ycombinator.com", "angellist.com",
      "producthunt.com", "clutch.co", "g2.com", "capterra.com",
      "a16z.com", "sequoiacap.com", "greylock.com", "foundationcapital.com",
      "crowdstrike.com", "paloaltonetworks.com", "sentinelone.com",
      "darktrace.com", "fortinet.com", "microsoft.com", "google.com",
      "amazon.com", "ibm.com", "danielscrivner.com"
    ]
  },
  "targeting": {
    "location_types": ["headquarters", "single_location"],
    "company_sizes": ["small", "mid-market"],
    "ownership_models": ["private"],
    "geographic_focus": ["United States"],
    "required_country": "United States"
  },
  "intent_config": {
    "purpose": "startup_advisory",
    "target_action": "business_development",
    "intent_signals": {
      "high_intent": [
        "startup advisory",
        "business consulting",
        "founder coaching",
        "mentoring services",
        "advisory board",
        "startup support",
        "entrepreneur guidance",
        "business development",
        "strategic planning",
        "coaching services"
      ],
      "medium_intent": [
        "business services",
        "consulting",
        "advisory services",
        "professional services",
        "business support",
        "strategic advice",
        "mentoring",
        "coaching"
      ],
      "low_intent": [
        "not accepting clients",
        "fully booked",
        "no availability"
      ]
    },
    "intent_sources": [
      "about_pages",
      "team_pages",
      "contact_pages",
      "services_pages"
    ],
    "scoring_rules": {
      "high_intent_weight": 0.8,
      "medium_intent_weight": 0.4,
      "low_intent_weight": -0.3,
      "base_score": 0.5,
      "location_bonus": 0.1,
      "size_bonus": 0.1,
      "leadership_bonus": 0.1
    }
  }
}